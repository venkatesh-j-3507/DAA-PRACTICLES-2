# Linear Search Program

n = int(input("Enter the number of elements: "))

arr = []

print("Enter the elements:")
for i in range(n):
    num = int(input())
    arr.append(num)

key = int(input("Enter the element to search: "))

found = False

for i in range(n):
    if arr[i] == key:
        print("Element found at index", i)
        found = True
        break

if found == False:
    print("Element not found")
